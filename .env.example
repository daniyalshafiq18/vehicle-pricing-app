# All environment variables are reserved for future configuration.
# The app currently hard-codes Dataverse as its data source.
VITE_APP_TITLE=Vehicle Pricing Intelligence Platform
VITE_APP_VERSION=1.0.0
VITE_CACHE_TTL=3600000
VITE_MAX_VEHICLE_DISPLAY=100

# Scraper Microservice
# URL of the deployed Puppeteer scraper service (e.g. Railway/Render)
# Used by the valuation wizard to fetch real-time price estimates
# VITE_SCRAPER_API_URL=https://your-service.up.railway.app

# Power Automate Flow 3 HTTP trigger URL — used to trigger YallaMotor scrapes.
# SECURITY: do NOT commit a real value here. Provide it at build time via the
# gitignored .env.local for local dev, and in the build environment for publish.
# Rotate the Power Automate trigger key to invalidate any previously-committed copy.
VITE_FLOW3_URL=

# Azure Functions `probe_py` base URL — the app's PRIMARY YallaMotor scrape path
# (Flow 3 stays as automatic fallback). No live value committed; set in the
# gitignored .env.local (dev) / build environment (publish).
VITE_AZURE_FUNCTION_URL=
